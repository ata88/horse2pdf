      "id": "xrechnung-ubl",
      "name": "XRechnung 3.0 (UBL)",
      "version": "2.6.0",
      "license": "Apache-2.0",
      "homepage": "https://github.com/itplr-kosit/xrechnung-schematron",
      "syntax": "UBL",
      "kind": "schematron",
      "main": "https://raw.githubusercontent.com/itplr-kosit/xrechnung-schematron/v2.6.0/src/validation/schematron/ubl/XRechnung-UBL-validation.sch",
      "includes": {
        "../common.sch": "https://raw.githubusercontent.com/itplr-kosit/xrechnung-schematron/v2.6.0/src/validation/schematron/common.sch"
      },
      "tokens": {
        "xr-schematron.version.full": "2.6.0",
        "xrechnung.version": "3.0.2"
      },
      "patches": [
        {
          "find": "xs:integer(string-join(for $cp in string-to-codepoints(concat(substring($normalizedIban,5)",
          "replace": "xs:decimal(string-join(for $cp in string-to-codepoints(concat(substring($normalizedIban,5)",
          "count": 1,
          "reason": "SaxonJS 2.7 represents xs:integer as a JS number and loses precision for the ~24 digit IBAN check number (mod 97 gives wrong results → false BR-DE-19 warnings). xs:decimal is exact."
        }
      ]
    },
