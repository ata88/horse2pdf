{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "horse2pdf",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "extra-files": [
        { "type": "toml", "path": "src-tauri/Cargo.toml", "jsonpath": "$.package.version" },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'horse2pdf')].version"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Neue Funktionen" },
        { "type": "fix", "section": "Fehlerbehebungen" },
        { "type": "perf", "section": "Performance" },
        { "type": "deps", "section": "Abhängigkeiten" },
        { "type": "docs", "section": "Dokumentation", "hidden": false },
        { "type": "refactor", "section": "Interne Änderungen", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Sonstiges", "hidden": true }
      ]
    }
  }
}
