{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!public/vendor", "!tests/fixtures", "!src-tauri/gen", "!src-tauri/icons", "!rules/sources.lock.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": { "noStaticElementInteractions": "off", "useKeyWithClickEvents": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
